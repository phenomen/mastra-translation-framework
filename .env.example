# Documents live in the workspace directory, which is src/mastra/public/workspace
# under `mastra dev` and .mastra/output/workspace under `mastra start`.

# You can any provider.
# See https://mastra.ai/models/
# AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=


# Model used by the translator and editor agents
# Make sure to use model name matching your provider
AI_MODEL="vercel/deepseek/deepseek-v4-flash"

# Optional. Enables Datalab remote OCR for PDFs.
# Without it, PDFs fall back to local text extraction.
DATALAB_API_KEY=
