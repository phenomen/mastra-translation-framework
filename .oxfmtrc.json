{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 80,
  "trailingComma": "all",
  "quoteProps": "consistent",
  "sortImports": true,
  "ignorePatterns": ["node_modules", ".mastra", "dist"]
}
